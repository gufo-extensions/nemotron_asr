{
  "schema": 1,
  "name": "nemotron_asr",
  "version": "0.2.0",
  "api_version": ">= 0.3.4",
  "depends": [],
  "platforms": ["linux"],
  "entry": "nemotron_asr_register",
  "registration_target": "gufo_nemotron_asr",
  "targets": {
    "gufo_nemotron_asr": { "requires": [] },
    "gufo_nemotron_asr_hip": { "requires": ["hip"] },
    "gufo_nemotron_asr_runner": { "requires": ["hip"] },
    "nemotron_asr_host_test": { "requires": ["testing"], "role": "test" },
    "nemotron_asr_features_test": { "requires": ["testing"], "role": "test" },
    "nemotron_asr_tokenizer_test": { "requires": ["testing"], "role": "test" },
    "nemotron_asr_model_test": { "requires": ["hip", "testing"], "role": "test" },
    "nemotron_asr_transcribe": { "requires": ["hip", "testing"], "role": "test" }
  },
  "providers": [
    {
      "id": "nemotron-asr",
      "capability": "speech_recognition",
      "keys": ["safetensors:nemotron3_5_asr", "safetensors:Nemotron3_5AsrForRNNT"],
      "model_ids": ["nemotron-3.5-asr-streaming-0.6b"],
      "target": "gufo_nemotron_asr_runner",
      "entry": "nemotron_asr_provider_register"
    }
  ],
  "options": [
    {
      "name": "--live-lookahead",
      "type": "integer",
      "commands": ["serve asr", "transcribe"],
      "providers": ["nemotron-asr"],
      "help": "Lookahead of live transcription in 80 ms encoder frames: 0, 3, 6 (default) or 13; text arrives in chunks of lookahead + 1 frames, and a longer lookahead makes fewer word errors"
    }
  ],
  "models": [
    {
      "id": "nemotron-3.5-asr",
      "provider": "nemotron-asr",
      "license": "openmdw-1.1",
