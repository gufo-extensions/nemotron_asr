      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "entry": ".",
          "source": {
            "hf": "nvidia/nemotron-3.5-asr-streaming-0.6b",
            "revision": "ea30d66debe3740a08b573244286791d423d6b3e"
          },
          "include": ["config.json", "model.safetensors", "processor_config.json", "tokenizer.json"]
        }
      ]
    }
  ],
